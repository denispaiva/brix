{
  "$schema": "../../../../vc/docs/standards/role-matrix.schema.json",
  "schemaVersion": "1.8.0",
  "project": "brix",
  "roles": {
    "product-owner": {
      "kind": "hybrid",
      "description": "Decide el alcance de la Fase 0 y sus decisiones D1 a D7, los veredictos de gate, la línea del ledger para la API de Gemini y qué cuenta como unidad de resultado del portfolio."
    },
    "architect": {
      "kind": "agent",
      "description": "Decide el contrato de los instrumentos de medición: reglas de atribución (D3, D6), formato de las series, precedencia de configuración del CLI y el límite entre el motor del Scoring Skill y su envoltorio en vc/tools/."
    },
    "senior-developer": {
      "kind": "agent",
      "description": "Construye los instrumentos de F1 en vc/brix/scripts/, los cambios del CLI y la migración del motor del Scoring Skill, con pruebas propias y sin funcionalidad nueva del CLI hasta cerrar la Fase 0."
    },
    "code-reviewer": {
      "kind": "agent",
      "description": "Audita de forma independiente y decorrelacionada el método de medición: reproducibilidad, validación contra el monitor de escasez y ausencia de contenido de transcripts en lo versionado."
    },
    "researcher": {
      "kind": "agent",
      "description": "Ejecuta F2, F3 y F4: diagnóstico del KPI vacío sobre la historia de git, comparación de unidades de resultado y evaluaciones de tooling con /tool."
    },
    "finops-analyst": {
      "kind": "agent",
      "description": "Valida la serie de minutos de Actions contra el monitor de escasez, mantiene la línea de Gemini en el ledger y las unit economics de los tres recursos escasos: atención del PO, minutos de Actions y ventana de contexto."
    }
  },
