{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brix.denispaiva.dev/seeding/scenario.v2.json",
  "title": "Escenario de sembrado v2",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "driver",
    "targets",
    "seed",
    "cleanup",
    "event",
    "accounts",
    "bots",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 2 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "driver": { "type": "string", "minLength": 1 },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "not": { "pattern": "prod" } }
    },
    "seed": { "type": "integer" },
    "cleanup": { "enum": ["manifest", "none"] },
    "event": { "type": "object" },
    "accounts": { "type": "array", "items": { "$ref": "#/$defs/account" } },
    "bots": { "type": "array", "items": { "$ref": "#/$defs/bot" } },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [{ "$ref": "#/$defs/step" }, { "$ref": "#/$defs/repeat" }]
      }
    }
  },
  "$defs": {
    "profile": {
      "enum": [
        "expert",
        "steady",
        "novice",
        "random",
        "slow",
        "quitter",
        "mixed"
      ]
    },
    "account": {
      "type": "object",
      "required": ["id", "role"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string" },
        "provider": { "type": "string" },
        "standIn": {
          "type": "object",
          "required": ["profile"],
          "additionalProperties": false,
          "properties": { "profile": { "$ref": "#/$defs/profile" } }
        }
      }
    },
    "bot": {
      "type": "object",
      "required": ["id", "kind", "profile"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "kind": { "enum": ["host", "guest"] },
        "count": { "type": "integer", "minimum": 1 },
        "profile": { "$ref": "#/$defs/profile" },
        "after": { "type": "integer", "minimum": 1 },
        "joinAfter": { "type": "array", "items": { "type": "string" } }
      }
    },
    "auto": {
      "type": "object",
      "required": ["op"],
      "additionalProperties": false,
      "properties": {
        "actor": { "type": "string" },
        "op": { "type": "string" },
        "args": { "type": "object" }
      }
    },
    "step": {
      "type": "object",
      "required": ["actor", "op"],
      "additionalProperties": false,
      "properties": {
        "n": { "type": "integer" },
        "actor": { "type": "string" },
        "op": {
          "enum": [
            "mint",
            "create_event",
            "join",
            "host_transition",
            "play",
            "capture",
            "reveal",
            "resolve_code",
            "read",
            "assert",
            "manual"
          ]
        },
        "args": { "type": "object" },
        "do": { "type": "string" },
        "captures": { "enum": ["event_code"] },
        "expect": {},
        "auto": { "$ref": "#/$defs/auto" }
      }
    },
    "repeat": {
      "type": "object",
      "required": ["repeat"],
      "additionalProperties": false,
      "properties": {
        "repeat": {
          "type": "object",
          "required": ["over", "as", "steps"],
          "additionalProperties": false,
          "properties": {
            "over": { "type": "string" },
            "as": { "type": "string" },
            "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } }
          }
        }
      }
    }
  }
}
