{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blends.local/schemas/billing-ledger/1.6.0",
  "title": "Blends FinOps Billing Ledger",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "frameworkVersion",
    "period",
    "currency",
    "owner",
    "items",
    "allocations",
    "sources",
    "summary",
    "controls"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.6.0"
    },
    "frameworkVersion": {
      "const": "1.81.0"
    },
    "period": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "currency": {
      "const": "USD"
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "workbookUrl": {
      "type": "string",
      "pattern": "^https://docs\\.google\\.com/spreadsheets/"
    },
    "items": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/billingItem"
      }
    },
    "allocations": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/allocation"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "controls": {
      "$ref": "#/$defs/controls"
    }
  },
  "$defs": {
    "billingItem": {
      "type": "object",
      "required": [
        "id",
        "provider",
        "service",
        "costPool",
        "billingModel",
        "plan",
        "quantity",
        "unitPriceUsd",
        "usageMultiplier",
        "budgetUsd",
        "forecastUsd",
        "actualUsd",
        "inputStatus",
        "reconciliationStatus",
        "sourceRef",
        "invoiceEvidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "provider": {
          "enum": [
            "firebase",
            "cloudflare",
            "anthropic",
            "openai",
            "moonshot",
            "namecheap",
            "google-workspace",
            "google-one",
            "google-play",
            "apple",
            "github",
            "expo",
            "google-gemini"
          ]
        },
        "service": {
          "type": "string",
          "minLength": 1
        },
        "costPool": {
          "enum": ["agents", "cloud", "tooling", "external"]
        },
        "billingModel": {
          "enum": ["fixed-subscription", "usage-based", "one-time"]
        },
        "plan": {
          "type": "string",
          "minLength": 1
        },
        "nextRenewalDate": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "quantity": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unitPriceUsd": {
          "type": "number",
          "minimum": 0
        },
        "usageMultiplier": {
          "type": ["string", "null"],
          "pattern": "^[1-9][0-9]*x$"
        },
        "budgetUsd": {
          "type": "number",
          "minimum": 0
        },
        "forecastUsd": {
          "type": "number",
          "minimum": 0
        },
        "actualUsd": {
          "type": "number",
          "minimum": 0
        },
        "inputStatus": {
          "enum": ["pending", "verified"]
        },
        "reconciliationStatus": {
          "enum": ["pending", "reconciled", "disputed"]
        },
        "sourceRef": {
          "type": "string",
          "minLength": 1
        },
        "invoiceEvidence": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "allocation": {
      "type": "object",
      "required": [
        "id",
        "billingItemId",
        "project",
        "environment",
        "owner",
        "costCenter",
        "version",
        "allocationPercent"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "billingItemId": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "costCenter": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "allocationPercent": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["id", "provider", "url", "checkedAt", "claim"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9-]*$"
        },
        "provider": {
          "enum": [
            "firebase",
            "cloudflare",
            "anthropic",
            "openai",
            "moonshot",
            "namecheap",
            "google-workspace",
            "google-one",
            "google-play",
            "apple",
            "github",
            "expo",
            "google-gemini"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "checkedAt": {
          "type": "string",
          "format": "date"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": [
        "totalBudgetUsd",
        "totalForecastUsd",
        "totalActualUsd",
        "monthlyFixedCommitmentUsd",
        "annualizedFixedCommitmentUsd",
        "cloudBillingForecastUsd",
        "cloudBillingActualUsd",
        "pendingInputCount",
        "unreconciledItemCount",
        "status"
      ],
      "properties": {
        "totalBudgetUsd": {
          "type": "number",
          "minimum": 0
        },
        "totalForecastUsd": {
          "type": "number",
          "minimum": 0
        },
        "totalActualUsd": {
          "type": "number",
          "minimum": 0
        },
        "monthlyFixedCommitmentUsd": {
          "type": "number",
          "minimum": 0
        },
        "annualizedFixedCommitmentUsd": {
          "type": "number",
          "minimum": 0
        },
        "cloudBillingForecastUsd": {
          "type": "number",
          "minimum": 0
        },
        "cloudBillingActualUsd": {
          "type": "number",
          "minimum": 0
        },
        "pendingInputCount": {
          "type": "integer",
          "minimum": 0
        },
        "unreconciledItemCount": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": ["pass", "attention", "blocked"]
        }
      },
      "additionalProperties": false
    },
    "controls": {
      "type": "object",
      "required": [
        "separateFixedAndUsage",
        "actualsRequireInvoiceEvidence",
        "allocationRequired",
        "providerReviewCadence",
        "humanApprovalForCommitments",
        "cloudBillingAlertUsd",
        "budgetGuardrailUsd"
      ],
      "properties": {
        "separateFixedAndUsage": {
          "const": true
        },
        "actualsRequireInvoiceEvidence": {
          "const": true
        },
        "allocationRequired": {
          "const": true
        },
        "providerReviewCadence": {
          "const": "monthly"
        },
        "humanApprovalForCommitments": {
          "const": true
        },
        "cloudBillingAlertUsd": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "budgetGuardrailUsd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
